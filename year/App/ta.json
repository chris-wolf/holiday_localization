  "holidaySpecial.7pmTillMidnight": "மாலை 7 மணி முதல் நள்ளிரவு வரை பகுதி விடுமுறை",
  "holidaySpecial.assumptionDayBavaria": "கன்னி மரியா விண்ணேற்றத் திருநாள் பவேரியாவில் பெரும்பாலும் கத்தோலிக்க மக்கள் வசிக்கும் நகராட்சிகளில் மட்டுமே ஒரு பொது விடுமுறை ஆகும்.",
  "holidaySpecial.azoresOnly": "அசோர்ஸில் மட்டும்",
  "holidaySpecial.chooseGoodFridayOrEasterMonday": "புனித வெள்ளி மற்றும் ஈஸ்டர் திங்கட்கிழமையில் ஒன்றை அவர்களின் சட்டபூர்வ விடுமுறையாகத் தேர்வு செய்தல்.",
  "holidaySpecial.cityOfBrisbaneOnly": "பிரிஸ்பேன் நகரத்தில் மட்டும்",
  "holidaySpecial.curpusChristiSaxony": "கார்பஸ் கிறிஸ்தி என்பது கார்பஸ் கிறிஸ்தி ஆணையில் பட்டியலிடப்பட்டுள்ள நகராட்சிகளில் ஒரு பொது விடுமுறை நாளாகும். சாக்ஸனியின் மீதமுள்ள நகராட்சிகளில், கார்பஸ் கிறிஸ்தி சாக்ஸன் விடுமுறைச் சட்டத்தின் பிரிவு 3(1) இன் படி ஒரு மத விடுமுறை நாளாகப் பாதுகாக்கப்படுகிறது.",
  "holidaySpecial.curpusChristiThuringia": "கார்ப்பஸ் கிறிஸ்டி § 2 பத்தி 2 மற்றும் § 10 பத்தி 1 ThürFGtG-க்கு ஏற்ப வரையறுக்கப்பட்ட நகராட்சிகளில் ஒரு பொது விடுமுறையாகும்; கார்ப்பஸ் கிறிஸ்டி நாளுக்கான நகராட்சிகள் குறியீட்டை காண்க.... துரிங்கியாவின் மீதமுள்ள நகராட்சிகளில், கார்ப்பஸ் கிறிஸ்டி துரிங்கிய விடுமுறை மற்றும் நினைவு நாள் சட்டத்தின் § 3 பத்தி 1 எண் 2 மூலம் ஒரு மத விடுமுறையாக பாதுகாக்கப்படுகிறது.",
  "holidaySpecial.defactoHoliday": "உண்மையில் நடைமுறையில் உள்ள விடுமுறை: அதிகாரப்பூர்வ விடுமுறை அல்ல, ஆனால் பெரும்பாலான பணியாளர்களுக்கு அந்த நாளில் விடுமுறை இருக்கும்.",
  "holidaySpecial.free_or_partitial_free_dependend_on_contract": "கூட்டு ஒப்பந்தத்தின் படி பணியிலிருந்து முழுமையாக அல்லது பகுதியளவில் விடுப்பு.",
  "holidaySpecial.goldCupParade": "மாநில அரசாங்கம் மற்றும் தலைநகர் பிராந்தியத்தில் உள்ள சில முதலாளிகளுக்குப் பண்டிகை விடுமுறையாகக் கடைப்பிடிக்கப்படுகிறது",
  "holidaySpecial.goodFridayGreece": "நல்ல வெள்ளிக்கிழமையன்று கடைகளின் செயல்பாடு பிற்பகல் 12:00 மணிக்கு முன்பும், பிற்பகல் 19:00 மணிக்குப் பின்னும் தடைசெய்யப்பட்டுள்ளது. பொதுவாக கடைகள் பிற்பகல் 12:00 மணிக்கு திறந்து, பிற்பகல் 19:00 மணிக்கு மூடப்படும் (முழு பிற்பகலும், மேலும் பிற்பகலின் முதல் இரண்டு மணிநேரங்களும் திறந்திருக்கும்)",
  "holidaySpecial.governmentEmployeesOnly": "அரசு ஊழியர்களுக்கு மட்டும் விடுமுறை",
  "holidaySpecial.holidayByCustom": "விருப்பப்படி விடுமுறை",
  "holidaySpecial.israeli_free_or_partitial_free_dependend_on_contract": "ஒப்பந்தத்தின் படி, இஸ்ரேலிய மத சமூக உறுப்பினர்களுக்கு முழுமையாக அல்லது பகுதியளவில் வேலை இல்லாத நாள்.",
  "holidaySpecial.mareidanOnly": "மடெய்ராவில் மட்டுமே கொண்டாடப்படுகிறது.",
  "holidaySpecial.mostBusinessesHaveClosed": "அதிகாரப்பூர்வ விடுமுறை அல்ல, ஆனால் பெரும்பாலான தொழில்கள் மூடப்பட்டுள்ளன.",
  "holidaySpecial.noHolidayButComonlyObsersvedGovermentFinancialBusinesses": "இது சட்டபூர்வமான விடுமுறை அல்ல, ஆனால் அனைத்து மட்ட அரசாங்கங்களாலும், நிதி நிறுவனங்களாலும் மற்றும் சில வணிக நிறுவனங்களாலும் பொதுவாகக் கடைப்பிடிக்கப்படுகிறது.",
  "holidaySpecial.northernTasmania": "Oatlands மற்றும் Swansea ஆகியவற்றைத் தவிர, அவற்றிற்கு வடக்கே உள்ள Tasmania-வின் அனைத்து பகுதிகளிலும் அனுசரிக்கப்படுகிறது.",
  "holidaySpecial.official_holiday_most_only_schools_and_authorities": "மாநிலச் சட்டத்தின்படி விடுமுறை; இது பெரும்பாலும் பள்ளிகள், அலுவலகங்கள் மற்றும் அதிகாரிகளையே பாதிக்கும்.",
  "holidaySpecial.onlyAugsburg": "ஆக்ஸ்பர்க் அமைதி விழா ஆக்ஸ்பர்க் நகரத்திலேயே மட்டும் கொண்டாடப்படும் பொது விடுமுறை (ஆனால் சுற்றுப்புறப் பகுதிகளில் அல்ல).",
  "holidaySpecial.onlyMoselleBas-RhinHaut-Rhin": "மொசெல், பாஸ்-ரின் மற்றும் ஓட்-ரின் துறைகளில் பிராந்தியமாக",
  "holidaySpecial.optional": "விருப்பத் தேர்வு விடுமுறை.",
  "holidaySpecial.optionalHolidayButUsuallyObserved": "ஆன்மாக்களின் நாள்",
  "holidaySpecial.publicServiceWorkers": "பொது சேவை பணியாளர்களுக்கான சட்டபூர்வ விடுமுறை. பல முதலாளிகள் தங்களது ஊழியர்களுக்கு சட்டபூர்வ விடுமுறையாக இல்லாமலும் விடுமுறை நாட்களை வழங்குகின்றனர்.",
  "holidaySpecial.regional": "சில பகுதிகளில் மட்டுமே.",
  "holidaySpecial.retailBusinessesMustBeClosed": "பொது விடுமுறை அல்ல, ஆனால் சில்லறை வணிகங்கள் மூடப்பட்டிருக்க வேண்டும்",
  "holidaySpecial.royalHobartRegatta": "தெற்கு மற்றும் கிழக்கு டாஸ்மேனியாவின் பெரும்பகுதிக்கான பொது விடுமுறை",
  "holidaySpecial.sales_are_allowed_to_work_in_special_cases": "அந்த நாள் வேலை நாளில் வந்தால், ஊழியர்களை சிறப்பு நிபந்தனைகளின் கீழ் விற்பனை நிலையங்களில் பணியமர்த்தலாம்.",
  "holidaySpecial.schoolsAndSomePublicServices": "பள்ளிகளும் சில பொதுச் சேவைகளும் அந்த நாளில் மூடப்படும்",
  "holidaySpecial.swiss1AG": "செவ்வாய் அல்லது சனிக்கிழமையில் வராதால் மட்டுமே சட்டபூர்வமாக அங்கீகரிக்கப்படுகிறது. இந்த விதியின் வரலாற்றுக் காரணம், அடிப்படை சேவைகளை உறுதிப்படுத்துவதற்காக தொடர்ச்சியாக மூன்று விடுமுறை நாட்கள் ஒருபோதும் இருக்கக் கூடாது என்பதுதான். இன்று இந்த விதி அரிதாகவே பின்பற்றப்படுகிறது; ஆகவே, வழக்கமாக ஒவ்வொரு ஆண்டும் வேலைஇடைவெளி ஒன்று உள்ளது.",
  "holidaySpecial.swiss2AG": "அது அதிகாரப்பூர்வ பொது விடுமுறை அல்ல என்றாலும், பெரும்பாலான நிறுவனங்கள் மதியம் வரை மட்டுமே செயல்படுகின்றன. அது திங்கட்கிழமையில் வந்தால், பெரும்பாலான இடங்களில் முழு நாளும் வேலை நிறுத்தப்படும்.",
  "holidaySpecial.swiss1NE_BT": "இது திங்கட்கிழமையில் வந்தால் மட்டுமே சட்டப்படி அங்கீகரிக்கப்படுகிறது. ஆனால் நடைமுறையில், பெர்ச்டோல்டின் நாள் பொதுவாக ஒவ்வோர் ஆண்டும் அனுசரிக்கப்படுகிறது.",
  "holidaySpecial.swiss1NE_ST": "திங்கட்கிழமையில் வந்தால் மட்டுமே சட்டபூர்வமாக அங்கீகரிக்கப்படும்.",
  "holidaySpecial.swissa": "ஞாயிற்றுக்கிழமைகள் அல்லது கன்டனின் சில நகராட்சிகளில் மட்டும் சட்டபூர்வமாக அங்கீகரிக்கப்பட்ட பிற விடுமுறைகளுக்கு இணையான விடுமுறை. இருப்பினும், பரவலாகக் கொண்டாடப்படும் சில நிகழ்வுகளுக்கு, கன்டனின் பிற பகுதிகளிலும் கட்டுப்பாடுகள் அல்லது கொண்டாட்டங்கள் எதிர்பார்க்கப்படலாம்.",
  "holidaySpecial.swissB": "முழு கான்டனிலும் சட்டப்படி அங்கீகரிக்கப்பட்ட பொது ஓய்வு நாள்",
  "holidaySpecial.swissC": "முழு மண்டலத்திலும் சட்டபூர்வமாக அங்கீகரிக்கப்பட்ட அரை விடுமுறை (பொதுவாக மதியம் 12:00 மணி முதல்)",
  "holidaySpecial.swissc": "சட்டப்பூர்வமாக அங்கீகரிக்கப்பட்ட அரை விடுமுறை (பொதுவாக பிற்பகல் 12:00 மணிக்கு தொடங்கும்) பொது பணியாளர்களுக்கு மட்டும், ஆனால் பொதுவாக அனைத்து பணிக்குழுக்களாலும் கடைப்பிடிக்கப்படுகிறது",
  "holidaySpecial.swissD": "சட்டத்தால் அங்கீகரிக்கப்படவில்லை, ஆனால் கான்டனில் உள்ள அனைத்து வேலைக் குழுக்களாலும் பொதுவாகக் கடைப்பிடிக்கப்படுகிறது.",
  "holidaySpecial.swissd": "சட்டத்தால் அங்கீகரிக்கப்படாதது, ஆனால் இது பொதுவாக சில நகராட்சிகளில் அனுசரிக்கப்படுகிறது",
  "holidaySpecial.whitMondayGreece": "பரிசுத்த ஆவியின் திருவிழா மாநிலத்தின் அதிகாரப்பூர்வ விடுமுறையாக அறிவிக்கப்பட்டுள்ளது. தனியார் நிறுவனங்களும் கடைகளும், அது சட்டம், கூட்டு தொழிலாளர் ஒப்பந்தம், அல்லது வணிக வழக்கம் மற்றும் மரபின்படி விடுமுறையாக அறிவிக்கப்பட்டிருந்தால், அதை அனுசரிக்கின்றன.",
  "holidaySpecial.nagerBank": "வங்கி விடுமுறை, வங்கிகளும் அலுவலகங்களும் மூடப்பட்டிருக்கும்",
  "holidaySpecial.nagerschool": "பள்ளி விடுமுறை, பள்ளிகள் மூடப்பட்டுள்ளன",
  "holidaySpecial.nagerAuthorities": "அதிகாரிகள் மூடப்பட்டுள்ளனர்",
  "holidaySpecial.nagerOptional": "பெரும்பாலானோர் ஒரு நாள் விடுப்பு எடுப்பார்கள்",
  "holidaySpecial.nagerObservance": "விருப்பத்திற்குரிய விழா, ஊதியத்துடன் கூடிய விடுப்பு இல்லை",
  "no_calendar_selected": "காலண்டர் எதுவும் தேர்ந்தெடுக்கப்படவில்லை."
}